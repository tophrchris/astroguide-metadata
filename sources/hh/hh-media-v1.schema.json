{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HH Optional Media v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "records"],
  "properties": {
    "schemaVersion": {"const": 1}, "packageVersion": {"type": "string", "minLength": 1},
    "records": {"type": "array", "maxItems": 20000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["assetID", "id", "role", "source", "sourceURL", "credit", "license", "licenseURL", "width", "height", "identityVerified", "emissionIdentified", "reuseVerified", "verifiedAt", "crop", "modifications", "rightsNote"],
      "properties": {
        "assetID": {"type": "string", "minLength": 1}, "id": {"type": "string", "pattern": "^hh:"},
        "role": {"enum": ["dedicated", "regional_identified", "survey_cutout"]},
        "source": {"type": "string", "minLength": 1}, "sourceURL": {"type": "string", "pattern": "^https://"},
        "credit": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1},
        "licenseURL": {"type": "string", "pattern": "^https://"},
        "width": {"type": "integer", "minimum": 640}, "height": {"type": "integer", "minimum": 480},
        "identityVerified": {"const": true}, "reuseVerified": {"const": true}, "emissionIdentified": {"type": "boolean"},
        "verifiedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "crop": {"type": "string", "minLength": 1}, "modifications": {"type": "string", "minLength": 1},
        "rightsNote": {"type": "string", "minLength": 1}
      }
    }}
  }
}
