{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HH Core v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "records", "catalog", "footprint", "dsoLinks"],
  "properties": {
    "databaseLicense": {"const": "ODbL-1.0"},
    "databaseLicenseURL": {"const": "https://opendatacommons.org/licenses/odbl/1-0/"},
    "sourceNotices": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "credit", "license", "evidenceURL"],
      "properties": {"source": {"type": "string", "minLength": 1}, "credit": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}, "evidenceURL": {"type": "string", "pattern": "^https://"}}
    }},
    "schemaVersion": {"const": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sha256", "fingerprint", "identityMapSHA256", "identityPolicy", "rowCount"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}, "fingerprint": {"$ref": "#/$defs/hash"},
        "identityMapSHA256": {"$ref": "#/$defs/hash"},
        "identityPolicy": {"type": "string", "minLength": 1},
        "rowCount": {"type": "integer", "minimum": 0, "maximum": 8000}
      }
    },
    "footprint": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "camera", "widthDeg", "heightDeg", "positionAngleDeg", "boundary", "centerPolicy"],
      "properties": {
        "model": {"const": "gnomonic-rectangle-v1"}, "camera": {"const": "S30 Pro main"},
        "widthDeg": {"const": 2.24}, "heightDeg": {"const": 3.99}, "positionAngleDeg": {"const": 0},
        "boundary": {"const": "inclusive-1e-12-tangent-tolerance"}, "centerPolicy": {"const": "one-reference-per-parent"}
      }
    },
    "records": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/record"}},
    "dsoLinks": {
      "type": "array", "maxItems": 8000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["targetID", "identityID", "hhIDs", "status"],
        "properties": {
          "targetID": {"type": "string", "minLength": 1}, "identityID": {"type": "string", "minLength": 1},
          "hhIDs": {"type": ["array", "null"], "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "status": {"enum": ["located", "unknown"]}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^hh:(?:[1-9][0-9]*|simbad:[0-9]+)(?::component:[a-z0-9-]+)?$"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "mainType", "status", "conflict", "confirmation"],
      "properties": {
        "source": {"type": "string", "minLength": 1}, "mainType": {"type": "string", "minLength": 1},
        "status": {"enum": ["source-classified", "historical-source-listed", "candidate", "confirmed"]},
        "conflict": {"type": "boolean"}, "confirmation": {"type": "string", "minLength": 1}
      }
    },
    "position": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["raDeg", "decDeg", "frame", "equinox", "inputFrame", "role", "epoch", "uncertaintyArcsec", "precisionArcsec"],
      "properties": {
        "raDeg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "decDeg": {"type": "number", "minimum": -90, "maximum": 90},
        "frame": {"const": "ICRS"}, "equinox": {"const": "J2000"},
        "inputFrame": {"enum": ["ICRS", "FK4/B1950"]},
        "role": {"enum": ["parent_center", "component_center", "representative_component_proxy"]},
        "epoch": {"type": ["number", "null"]},
        "uncertaintyArcsec": {"type": ["number", "null"], "minimum": 0},
        "precisionArcsec": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "sourceID", "retrievedAt", "inputSHA256", "sourceURL"],
        "properties": {
          "source": {"type": "string", "minLength": 1}, "sourceID": {"type": "string", "minLength": 1},
          "retrievedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "inputSHA256": {"$ref": "#/$defs/hash"}, "sourceURL": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentID", "name", "aliases", "kind", "classification", "position", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "parentID": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "kind": {"enum": ["parent", "component"]}, "classification": {"$ref": "#/$defs/classification"},
        "classifications": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "position": {"$ref": "#/$defs/position"}, "provenance": {"$ref": "#/$defs/provenance"},
        "positionAlternatives": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["position", "provenance"],
            "properties": {"position": {"$ref": "#/$defs/position"}, "provenance": {"$ref": "#/$defs/provenance"}}
          }
        }
      }
    }
  }
}
