{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadata.astroguide.space/schemas/star-party-astrosite-source-v1.schema.json",
  "title": "AstroGuide Star Party AstroSite source record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordKind",
    "id",
    "displayName",
    "description",
    "descriptionSources",
    "astroSite",
    "location",
    "officialURLs",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordKind": {
      "const": "starPartyAstroSite"
    },
    "id": {
      "$ref": "#/$defs/kebabID"
    },
    "displayName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320
    },
    "descriptionSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "astroSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceSiteID",
        "name",
        "latitude",
        "longitude",
        "preferredPathPreviewCenterDirectionRaw"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceSiteID": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevationMeters": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        },
        "preferredPathPreviewCenterDirectionRaw": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venueName",
        "locality",
        "region",
        "countryCode",
        "countryName",
        "timezone",
        "coordinateSource"
      ],
      "properties": {
        "venueName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locality": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "region": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "countryName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "coordinateSource": {
          "$ref": "#/$defs/source"
        },
        "relatedDarkSkyPlaceID": {
          "type": "string",
          "pattern": "^darksky:"
        }
      }
    },
    "officialURLs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "url"
        ],
        "properties": {
          "role": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "url": {
            "$ref": "#/$defs/httpsURL"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "start",
          "end",
          "status",
          "url",
          "source"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebabID"
          },
          "name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "url": {
            "$ref": "#/$defs/httpsURL"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hero": {
          "$ref": "#/$defs/mediaAsset"
        },
        "logo": {
          "$ref": "#/$defs/mediaAsset"
        }
      }
    },
    "horizonResources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/horizonResource"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "kebabID": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "verifiedAt"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/httpsURL"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetPath",
        "sourceURL",
        "attribution",
        "license",
        "permissionNotes",
        "verifiedAt"
      ],
      "properties": {
        "assetPath": {
          "type": "string",
          "pattern": "^v1/assets/star-party-astrosites/"
        },
        "sourceURL": {
          "$ref": "#/$defs/httpsURL"
        },
        "attribution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "permissionNotes": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "horizonResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "quality",
        "disposition",
        "source",
        "rights",
        "calibration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabID"
        },
        "kind": {
          "enum": [
            "panorama",
            "hrz"
          ]
        },
        "quality": {
          "enum": [
            "authoritative_hrz",
            "manual_trace_from_panorama",
            "estimated_from_panorama",
            "visual_panorama_only"
          ]
        },
        "disposition": {
          "enum": [
            "cached_visual_reference",
            "cached_obstruction_profile",
            "link_only_pending_permission",
            "link_only_research",
            "rejected_viewpoint_mismatch"
          ]
        },
        "source": {
          "$ref": "#/$defs/horizonSource"
        },
        "rights": {
          "$ref": "#/$defs/horizonRights"
        },
        "calibration": {
          "$ref": "#/$defs/horizonCalibration"
        },
        "asset": {
          "$ref": "#/$defs/horizonImageAsset"
        },
        "obstructionProfile": {
          "$ref": "#/$defs/horizonObstructionProfile"
        }
      }
    },
    "horizonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pageURL",
        "resourceURL",
        "creator",
        "verifiedAt"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pageURL": {
          "$ref": "#/$defs/httpsURL"
        },
        "resourceURL": {
          "$ref": "#/$defs/httpsURL"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "horizonRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permissionStatus",
        "licenseName",
        "licenseURL",
        "attribution",
        "notes"
      ],
      "properties": {
        "permissionStatus": {
          "enum": [
            "licensed_for_redistribution",
            "permission_required",
            "unknown"
          ]
        },
        "licenseName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "licenseURL": {
          "anyOf": [
            {
              "$ref": "#/$defs/httpsURL"
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "horizonCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewpointDescription",
        "viewpointMatch",
        "northAzimuthOffsetDegrees",
        "projectionType",
        "horizontalFieldOfViewDegrees",
        "verticalFieldOfViewDegrees",
        "verticalScale",
        "suitableForObstructionCalculations",
        "notes"
      ],
      "properties": {
        "viewpointDescription": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "viewpointMatch": {
          "enum": [
            "exact",
            "approximate",
            "unverified",
            "different"
          ]
        },
        "northAzimuthOffsetDegrees": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -360,
          "maximum": 360
        },
        "projectionType": {
          "enum": [
            "equirectangular",
            "cylindrical",
            "unknown_stitched",
            "unknown"
          ]
        },
        "horizontalFieldOfViewDegrees": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "verticalFieldOfViewDegrees": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "verticalScale": {
          "enum": [
            "calibrated",
            "estimated",
            "unknown"
          ]
        },
        "suitableForObstructionCalculations": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "horizonImageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byteSize",
        "width",
        "height",
        "derivativeNotes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^v1/assets/star-party-astrosites/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "derivativeNotes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "horizonObstructionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "assetPath",
        "sampleCount",
        "wind16Aggregation"
      ],
      "properties": {
        "format": {
          "const": "azimuthAltitudeDegrees"
        },
        "assetPath": {
          "type": "string",
          "pattern": "^v1/assets/star-party-astrosites/.*\\.hrz$"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "wind16Aggregation": {
          "const": "average"
        }
      }
    }
  }
}
